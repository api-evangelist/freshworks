{
  "opencollection": "1.0.0",
  "info": {
    "name": "Freshworks Freshcaller Accounts API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "X-Api-Auth",
      "value": "{{X-Api-Auth}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Accounts",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List all accounts",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{domain}.freshcaller.com/api/v1/sales_accounts",
            "params": [
              {
                "name": "page",
                "value": "",
                "type": "query",
                "description": "Page number for pagination."
              },
              {
                "name": "sort",
                "value": "",
                "type": "query",
                "description": "Field to sort by."
              },
              {
                "name": "sort_type",
                "value": "",
                "type": "query",
                "description": "Sort order direction."
              }
            ]
          },
          "docs": "Retrieves a paginated list of all company accounts in the CRM."
        },
        {
          "info": {
            "name": "Create an account",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{domain}.freshcaller.com/api/v1/sales_accounts",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Creates a new company account in the CRM."
        },
        {
          "info": {
            "name": "View an account",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{domain}.freshcaller.com/api/v1/sales_accounts/:account_id",
            "params": [
              {
                "name": "account_id",
                "value": "",
                "type": "path",
                "description": "The ID of the account."
              }
            ]
          },
          "docs": "Retrieves the details of a specific company account by its ID."
        },
        {
          "info": {
            "name": "Update an account",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://{domain}.freshcaller.com/api/v1/sales_accounts/:account_id",
            "params": [
              {
                "name": "account_id",
                "value": "",
                "type": "path",
                "description": "The ID of the account."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Updates the properties of an existing company account."
        },
        {
          "info": {
            "name": "Delete an account",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://{domain}.freshcaller.com/api/v1/sales_accounts/:account_id",
            "params": [
              {
                "name": "account_id",
                "value": "",
                "type": "path",
                "description": "The ID of the account."
              }
            ]
          },
          "docs": "Deletes a company account from the CRM."
        }
      ]
    }
  ],
  "bundled": true
}