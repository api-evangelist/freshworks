{
  "opencollection": "1.0.0",
  "info": {
    "name": "Freshworks Freshcaller Accounts Sales Activities API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "X-Api-Auth",
      "value": "{{X-Api-Auth}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Sales Activities",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List all sales activities",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{domain}.freshcaller.com/api/v1/sales_activities",
            "params": [
              {
                "name": "page",
                "value": "",
                "type": "query",
                "description": "Page number for pagination."
              }
            ]
          },
          "docs": "Retrieves a paginated list of all sales activities in the CRM."
        },
        {
          "info": {
            "name": "Create a sales activity",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{domain}.freshcaller.com/api/v1/sales_activities",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Creates a new sales activity record in the CRM."
        }
      ]
    }
  ],
  "bundled": true
}