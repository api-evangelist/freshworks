{
  "opencollection": "1.0.0",
  "info": {
    "name": "Freshworks Freshcaller Accounts Notes API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "X-Api-Auth",
      "value": "{{X-Api-Auth}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Notes",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Create a note",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{domain}.freshcaller.com/api/v1/notes",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Creates a new note attached to a CRM record (contact, account, deal, or lead)."
        },
        {
          "info": {
            "name": "Delete a note",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://{domain}.freshcaller.com/api/v1/notes/:note_id",
            "params": [
              {
                "name": "note_id",
                "value": "",
                "type": "path",
                "description": "The ID of the note."
              }
            ]
          },
          "docs": "Deletes a note from the CRM."
        }
      ]
    }
  ],
  "bundled": true
}