{
  "opencollection": "1.0.0",
  "info": {
    "name": "Freshworks Freshcaller Accounts Agents API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "X-Api-Auth",
      "value": "{{X-Api-Auth}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Agents",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List all agents",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{domain}.freshcaller.com/api/v1/agents",
            "params": [
              {
                "name": "page",
                "value": "",
                "type": "query",
                "description": "Page number for pagination."
              },
              {
                "name": "items_per_page",
                "value": "",
                "type": "query",
                "description": "Number of items per page."
              }
            ]
          },
          "docs": "Retrieves a list of all agents configured for the Freshchat account, including their availability status."
        },
        {
          "info": {
            "name": "View an agent",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{domain}.freshcaller.com/api/v1/agents/:agent_id",
            "params": [
              {
                "name": "agent_id",
                "value": "",
                "type": "path",
                "description": "The ID of the agent."
              }
            ]
          },
          "docs": "Retrieves the metadata and availability status of a specific agent."
        },
        {
          "info": {
            "name": "Update an agent",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://{domain}.freshcaller.com/api/v1/agents/:agent_id",
            "params": [
              {
                "name": "agent_id",
                "value": "",
                "type": "path",
                "description": "The ID of the agent."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Updates the properties of an existing agent."
        }
      ]
    }
  ],
  "bundled": true
}